{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-cn",
        "address": "223.5.5.5",
        "detour": "direct"
      },
      {
        "tag": "dns-cn-backup",
        "address": "119.29.29.29",
        "detour": "direct"
      },
      {
        "tag": "dns-proxy",
        "address": "https://1.1.1.1/dns-query",
        "detour": "proxy"
      }
    ],
    "rules": [
      {
        "domain": [
          "molin.myds.me",
          "smalin.myds.me"
        ],
        "domain_suffix": [
          "molin.myds.me",
          "smalin.myds.me"
        ],
        "server": "dns-cn"
      },
      {
        "rule_set": [
          "geolocation-cn"
        ],
        "server": "dns-cn"
      },
      {
        "rule_set": [
          "geolocation-!cn"
        ],
        "server": "dns-proxy"
      }
    ],
    "final": "dns-proxy",
    "strategy": "prefer_ipv4",
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "sniff": true,
      "sniff_override_destination": false
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "direct"
      ],
      "default": "auto"
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "REPLACE_WITH_YOUR_NODE_1",
        "REPLACE_WITH_YOUR_NODE_2"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "geolocation-cn",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-cn.json",
        "update_interval": "1d"
      },
      {
        "tag": "geolocation-!cn",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.json",
        "update_interval": "1d"
      },
      {
        "tag": "category-ads-all",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.json",
        "update_interval": "1d"
      },
      {
        "tag": "private",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.json",
        "update_interval": "1d"
      },
      {
        "tag": "openai",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/openai.json",
        "update_interval": "1d"
      },
      {
        "tag": "anthropic",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/anthropic.json",
        "update_interval": "1d"
      },
      {
        "tag": "telegram",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.json",
        "update_interval": "1d"
      },
      {
        "tag": "netflix",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/netflix.json",
        "update_interval": "1d"
      },
      {
        "tag": "youtube",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.json",
        "update_interval": "1d"
      },
      {
        "tag": "disney",
        "type": "remote",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/disney.json",
        "update_interval": "1d"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "domain": [
          "molin.myds.me",
          "smalin.myds.me"
        ],
        "domain_suffix": [
          "molin.myds.me",
          "smalin.myds.me"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "private"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "category-ads-all"
        ],
        "action": "route",
        "outbound": "block"
      },
      {
        "rule_set": [
          "openai",
          "anthropic"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "telegram"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geolocation-cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geolocation-!cn"
        ],
        "action": "route",
        "outbound": "proxy"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_rdrc": true
    }
  }
}
